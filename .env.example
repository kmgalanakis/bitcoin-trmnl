# The account's extended public key from Ledger Live:
# open the account, click the wrench icon, then Advanced, and copy the xpub.
# It cannot spend coins, but it reveals every address and transaction, so never commit it.
XPUB=

# The mempool REST API. Point it at your own mempool server to keep your addresses private.
API_BASE=https://mempool.space/api

# Stop each address chain after this many unused addresses in a row.
GAP_LIMIT=20

# Seconds between wallet scans. /wallet always answers with the latest finished scan.
SCAN_SECONDS=600

# Seconds to wait between API requests. mempool.space answers 429 when asked too fast.
REQUEST_DELAY=0.5

# Transactions to return.
MAX_TXS=10
